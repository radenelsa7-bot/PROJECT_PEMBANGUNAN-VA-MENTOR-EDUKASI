# Salin menjadi .env  (NFR-08: jangan commit .env / API key ke repositori)
DATABASE_URL=sqlite:///./vame.db
SECRET_KEY=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Penyedia LLM: mock | openai | anthropic | local   (FR-34)
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local LLM kompatibel OpenAI (mis. Ollama: http://localhost:11434/v1)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_BACKOFF_BASE=0.5

PASS_THRESHOLD=70
MIN_MENTOR_INTERACTIONS=1
RATE_LIMIT_AI_PER_MINUTE=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
